# AWS Infrastructure Monitor — Environment Variables
# Copy this file to .env and fill in the values before starting the application.
# NEVER commit .env to version control.

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME="AWS Infrastructure Monitor"

# ─── Database (MySQL) ─────────────────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/aws_monitor

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT / Session ────────────────────────────────────────────────────────────
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex')|Write-Output"
JWT_SECRET=changeme_use_a_long_random_secret_at_least_64_characters_long
JWT_EXPIRES_IN=8h

# ─── CSRF ─────────────────────────────────────────────────────────────────────
CSRF_SECRET=changeme_another_long_random_secret_for_csrf_protection

# ─── AWS Credentials ──────────────────────────────────────────────────────────
# Prefer IAM roles when running inside AWS (leave these blank in that case).
# When running outside AWS (e.g., on a VPS), supply access key credentials.
# Credentials are NEVER logged or exposed to templates.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: override the endpoint (useful for LocalStack in development)
AWS_ENDPOINT_URL=

# ─── Metrics Collection ───────────────────────────────────────────────────────
# Interval at which BullMQ schedules a metric collection run (cron syntax)
METRICS_CRON=*/5 * * * *
# CloudWatch metric period in seconds (must align with collection interval)
METRICS_PERIOD_SECONDS=300
# How many days to retain raw metric snapshots
METRICS_RETENTION_DAYS=90

# ─── Reports ──────────────────────────────────────────────────────────────────
REPORTS_OUTPUT_DIR=./storage/reports

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
