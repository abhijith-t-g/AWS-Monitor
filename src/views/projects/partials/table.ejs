<!-- Projects Table Partial (HTMX target) -->
<% if (projects.length === 0) { %>
  <div class="bg-slate-900 border border-slate-800 rounded-2xl flex flex-col items-center justify-center py-16 text-center">
    <svg class="w-12 h-12 text-slate-700 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
    </svg>
    <p class="text-slate-500 text-sm">No projects found</p>
    <a href="/projects/new" class="mt-3 text-brand-400 hover:text-brand-300 text-sm">Create your first project →</a>
  </div>
<% } else { %>
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-800">
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Project</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">AWS Account</th>
          <th class="text-center px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Resources</th>
          <th class="text-right px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Created</th>
          <th class="text-right px-6 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% projects.forEach(function(project) { %>
          <tr class="hover:bg-slate-800/40 transition-colors">
            <td class="px-6 py-4">
              <a href="/projects/<%= project.id %>" class="font-medium text-slate-100 hover:text-brand-400 transition-colors">
                <%= project.name %>
              </a>
              <% if (project.description) { %>
                <div class="text-xs text-slate-500 mt-0.5 truncate max-w-xs"><%= project.description %></div>
              <% } %>
            </td>
            <td class="px-4 py-4">
              <% if (project.awsAccountId) { %>
                <span class="font-mono text-xs text-slate-400 bg-slate-800 px-2 py-0.5 rounded"><%= project.awsAccountId %></span>
              <% } else { %>
                <span class="text-slate-600">—</span>
              <% } %>
            </td>
            <td class="px-4 py-4 text-center">
              <span class="font-semibold text-slate-300"><%= project._count.resources %></span>
            </td>
            <td class="px-4 py-4 text-right text-slate-400 text-xs">
              <%= new Date(project.createdAt).toLocaleDateString() %>
            </td>
            <td class="px-6 py-4 text-right">
              <div class="flex items-center justify-end gap-2">
                <a href="/projects/<%= project.id %>"
                   class="px-3 py-1.5 rounded-lg text-xs text-brand-400 border border-brand-600/30 hover:bg-brand-600/10 transition-colors">
                  View
                </a>
                <a href="/projects/<%= project.id %>/edit"
                   class="px-3 py-1.5 rounded-lg text-xs text-slate-300 border border-slate-700 hover:bg-slate-700 transition-colors">
                  Edit
                </a>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <%- include('../../partials/pagination.ejs', { page, totalPages, total }) %>
  </div>
<% } %>
