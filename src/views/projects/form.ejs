<!-- Project Create/Edit Form -->
<div class="max-w-2xl">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
    <h2 class="text-lg font-semibold text-slate-100 mb-6">
      <%= project ? 'Edit Project' : 'Create New Project' %>
    </h2>

    <form method="POST" action="<%= project ? '/projects/' + project.id : '/projects' %>">
      <div class="space-y-5">

        <div>
          <label for="name" class="block text-sm font-medium text-slate-300 mb-1.5">
            Project Name <span class="text-red-400">*</span>
          </label>
          <input id="name" type="text" name="name"
                 value="<%= project ? project.name : '' %>"
                 required maxlength="100"
                 class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border
                        <%= errors && errors.name ? 'border-red-500' : 'border-slate-700' %>
                        text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm transition-all">
          <% if (errors && errors.name) { %>
            <p class="mt-1 text-xs text-red-400"><%= errors.name[0] %></p>
          <% } %>
        </div>

        <div>
          <label for="description" class="block text-sm font-medium text-slate-300 mb-1.5">Description</label>
          <textarea id="description" name="description" rows="3" maxlength="500"
                    class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-100
                           placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm resize-none transition-all"
                    placeholder="Brief description of this project"><%= project && project.description ? project.description : '' %></textarea>
        </div>

        <div>
          <label for="awsAccountId" class="block text-sm font-medium text-slate-300 mb-1.5">
            AWS Account ID
            <span class="text-slate-500 font-normal">(12 digits, optional)</span>
          </label>
          <input id="awsAccountId" type="text" name="awsAccountId"
                 value="<%= project && project.awsAccountId ? project.awsAccountId : '' %>"
                 pattern="\d{12}" maxlength="12" placeholder="123456789012"
                 class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border
                        <%= errors && errors.awsAccountId ? 'border-red-500' : 'border-slate-700' %>
                        text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm font-mono transition-all">
          <% if (errors && errors.awsAccountId) { %>
            <p class="mt-1 text-xs text-red-400"><%= errors.awsAccountId[0] %></p>
          <% } %>
        </div>
      </div>

      <div class="flex items-center gap-3 mt-8">
        <button type="submit"
                class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm transition-colors shadow-lg shadow-brand-900/30 focus:outline-none focus:ring-2 focus:ring-brand-500">
          <%= project ? 'Save Changes' : 'Create Project' %>
        </button>
        <a href="<%= project ? '/projects/' + project.id : '/projects' %>"
           class="px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 hover:bg-slate-700 text-sm transition-colors">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
