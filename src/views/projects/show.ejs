<!-- Project Metrics & Detail View -->
<div class="space-y-6" x-data="{
  startDate: '',
  endDate: '',
  setPreset(days) {
    const end = new Date();
    const start = new Date(Date.now() - days * 24 * 60 * 60 * 1000);
    if (document.getElementById('project-start-date')?._flatpickr) {
      document.getElementById('project-start-date')._flatpickr.setDate(start);
      document.getElementById('project-end-date')._flatpickr.setDate(end);
    }
  },
  setThisMonth() {
    const end = new Date();
    const start = new Date(end.getFullYear(), end.getMonth(), 1);
    if (document.getElementById('project-start-date')?._flatpickr) {
      document.getElementById('project-start-date')._flatpickr.setDate(start);
      document.getElementById('project-end-date')._flatpickr.setDate(end);
    }
  },
  triggerExport() {
    const start = document.getElementById('project-start-date')?.value || '';
    const end = document.getElementById('project-end-date')?.value || '';
    const url = '/projects/<%= project.id %>/export?startDate=' + encodeURIComponent(start) + '&endDate=' + encodeURIComponent(end);
    window.location.href = url;
  }
}">

  <!-- Breadcrumb & Top Bar -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 text-xs text-slate-500 mb-1.5">
        <a href="/projects" class="hover:text-slate-300 transition-colors">Projects</a>
        <span>›</span>
        <span class="text-slate-300 font-medium"><%= project.name %></span>
      </div>
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-bold text-white tracking-tight"><%= project.name %></h2>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-500/10 border border-blue-500/20 text-blue-400">
          <%= project.resources.length %> AWS Resources
        </span>
      </div>
      <% if (project.description) { %>
        <p class="text-slate-400 text-sm mt-1"><%= project.description %></p>
      <% } %>
    </div>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <a href="/projects/<%= project.id %>/resources/new"
         class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-sm font-semibold transition-all shadow-lg shadow-blue-900/30">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        Add AWS Resource
      </a>
      <a href="/projects/<%= project.id %>/edit"
         class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 hover:bg-slate-700 text-sm font-medium transition-colors">
        Edit
      </a>
    </div>
  </div>

  <!-- Excel Export & Date Range Calendar Bar -->
  <div class="bg-gradient-to-r from-slate-900 via-slate-900/90 to-blue-950/40 border border-slate-800 rounded-2xl p-4 shadow-xl">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          <span class="text-sm font-bold text-slate-100">Export Project Metrics to Excel</span>
        </div>
        <p class="text-xs text-slate-400 mt-0.5">Select custom date & time range to generate a formatted multi-sheet .xlsx workbook</p>
      </div>

      <!-- Calendar Controls & Export Button -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Quick Presets -->
        <div class="flex items-center gap-1 bg-slate-950/60 p-1 rounded-xl border border-slate-800">
          <button type="button" @click="setPreset(1)" class="px-2.5 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
            24h
          </button>
          <button type="button" @click="setPreset(7)" class="px-2.5 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
            7 Days
          </button>
          <button type="button" @click="setPreset(30)" class="px-2.5 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
            30 Days
          </button>
          <button type="button" @click="setThisMonth()" class="px-2.5 py-1 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
            This Month
          </button>
        </div>

        <!-- Date Inputs -->
        <div class="flex items-center gap-2">
          <div class="relative">
            <input id="project-start-date" type="text" placeholder="Start Date..."
                   class="w-40 px-3 py-1.5 pl-8 rounded-xl bg-slate-800 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-blue-500 font-mono">
            <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-xs text-slate-500">to</span>
          <div class="relative">
            <input id="project-end-date" type="text" placeholder="End Date..."
                   class="w-40 px-3 py-1.5 pl-8 rounded-xl bg-slate-800 border border-slate-700 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-blue-500 font-mono">
            <svg class="w-3.5 h-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        </div>

        <!-- Download Button -->
        <button
          type="button"
          @click="triggerExport()"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-lg shadow-emerald-950/40 cursor-pointer">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Export to Excel
        </button>
      </div>
    </div>
  </div>

  <!-- Project Resource Metrics Matrix Table -->
  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
      <div>
        <h3 class="text-base font-bold text-white tracking-tight">Project Resources Matrix</h3>
        <p class="text-xs text-slate-400">Live health telemetry, utilization metrics, and CloudWatch snapshot status</p>
      </div>
      <% if (project.awsAccountId) { %>
        <span class="inline-flex items-center gap-1.5 text-xs text-slate-400 bg-slate-950 px-3 py-1.5 rounded-xl border border-slate-800">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
          AWS Account: <span class="font-mono text-slate-200"><%= project.awsAccountId %></span>
        </span>
      <% } %>
    </div>

    <% if (project.resources.length === 0) { %>
      <div class="flex flex-col items-center justify-center py-16 text-center">
        <div class="w-14 h-14 rounded-2xl bg-slate-800 flex items-center justify-center mb-3">
          <svg class="w-7 h-7 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
        </div>
        <p class="text-slate-300 font-semibold">No AWS resources configured</p>
        <p class="text-slate-500 text-xs mt-1">Add your EC2 instances, RDS databases, or ECS services to start monitoring.</p>
        <a href="/projects/<%= project.id %>/resources/new"
           class="mt-4 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white text-xs font-semibold transition-colors">
          Add Resource →
        </a>
      </div>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-950/60 text-slate-400 font-semibold border-b border-slate-800 uppercase tracking-wider">
            <tr>
              <th class="px-6 py-3.5">Resource Name & AWS ID</th>
              <th class="px-4 py-3.5">Type</th>
              <th class="px-4 py-3.5">Region</th>
              <th class="px-4 py-3.5">Health State</th>
              <th class="px-4 py-3.5">Latest CPU</th>
              <th class="px-4 py-3.5">Latest Memory</th>
              <th class="px-4 py-3.5">Latest Disk</th>
              <th class="px-4 py-3.5">Network In/Out</th>
              <th class="px-4 py-3.5 text-center">Snapshots</th>
              <th class="px-6 py-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-800 text-slate-300">
            <% project.resources.forEach(function(resource) { %>
              <%
                const latestSnap = resource.metricSnapshots && resource.metricSnapshots.length > 0 ? resource.metricSnapshots[0] : null;
                const cpuVal = latestSnap && latestSnap.cpuUtilization !== null ? latestSnap.cpuUtilization.toFixed(1) : null;
                const memVal = latestSnap && latestSnap.memoryUtilization !== null ? latestSnap.memoryUtilization.toFixed(1) : null;
                const diskVal = latestSnap && latestSnap.diskUtilization !== null ? latestSnap.diskUtilization.toFixed(1) : null;
                const netInMb = latestSnap && latestSnap.networkInBytes !== null ? (Number(latestSnap.networkInBytes) / (1024*1024)).toFixed(2) : null;
                const netOutMb = latestSnap && latestSnap.networkOutBytes !== null ? (Number(latestSnap.networkOutBytes) / (1024*1024)).toFixed(2) : null;

                const isCrit = cpuVal !== null && Number(cpuVal) >= 85;
                const isWarn = cpuVal !== null && Number(cpuVal) >= 70 && Number(cpuVal) < 85;
                const isHealthy = cpuVal !== null && Number(cpuVal) < 70;
                const widthPercent = cpuVal !== null ? Math.min(Number(cpuVal), 100) : 0;
              %>
              <tr class="hover:bg-slate-800/40 transition-colors">
                <!-- Resource info -->
                <td class="px-6 py-4">
                  <a href="/projects/<%= project.id %>/resources/<%= resource.id %>"
                     class="font-semibold text-slate-100 hover:text-blue-400 transition-colors text-sm">
                    <%= resource.name %>
                  </a>
                  <div class="text-[11px] text-slate-500 font-mono mt-0.5"><%= resource.awsResourceId %></div>
                </td>

                <!-- Type -->
                <td class="px-4 py-4">
                  <span class="px-2 py-0.5 rounded text-[11px] font-medium bg-slate-800 text-slate-300 border border-slate-700">
                    <%= resource.resourceType.replace(/_/g, ' ') %>
                  </span>
                </td>

                <!-- Region -->
                <td class="px-4 py-4 text-slate-400 font-mono text-xs"><%= resource.region %></td>

                <!-- Health State -->
                <td class="px-4 py-4">
                  <% if (latestSnap) { %>
                    <% if (isCrit) { %>
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold bg-red-900/40 border border-red-700/50 text-red-400">
                        <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                        Critical
                      </span>
                    <% } else if (isWarn) { %>
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold bg-amber-900/40 border border-amber-700/50 text-amber-400">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                        Warning
                      </span>
                    <% } else { %>
                      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold bg-emerald-900/40 border border-emerald-700/50 text-emerald-400">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                        Healthy
                      </span>
                    <% } %>
                  <% } else { %>
                    <span class="text-slate-600 text-[11px]">Pending Poll</span>
                  <% } %>
                </td>

                <!-- Latest CPU -->
                <td class="px-4 py-4 font-mono">
                  <% if (cpuVal !== null) { %>
                    <div class="flex items-center gap-2">
                      <span class="font-bold <%= isCrit ? 'text-red-400' : (isWarn ? 'text-amber-400' : 'text-slate-200') %>"><%= cpuVal %>%</span>
                      <div class="w-10 h-1.5 rounded-full bg-slate-800 overflow-hidden">
                        <div class="h-full <%= isCrit ? 'bg-red-500' : (isWarn ? 'bg-amber-500' : 'bg-blue-500') %>" :style="'width: <%= widthPercent %>%'"></div>
                      </div>
                    </div>
                  <% } else { %>
                    <span class="text-slate-600">—</span>
                  <% } %>
                </td>

                <!-- Latest Memory -->
                <td class="px-4 py-4 font-mono">
                  <%= memVal !== null ? memVal + '%' : '<span class="text-slate-600">—</span>' %>
                </td>

                <!-- Latest Disk -->
                <td class="px-4 py-4 font-mono">
                  <%= diskVal !== null ? diskVal + '%' : '<span class="text-slate-600">—</span>' %>
                </td>

                <!-- Network -->
                <td class="px-4 py-4 font-mono text-[11px]">
                  <% if (netInMb !== null && netOutMb !== null) { %>
                    <div>↓ <%= netInMb %> MB</div>
                    <div class="text-slate-500">↑ <%= netOutMb %> MB</div>
                  <% } else { %>
                    <span class="text-slate-600">—</span>
                  <% } %>
                </td>

                <!-- Snapshots count -->
                <td class="px-4 py-4 text-center font-mono text-slate-400 font-bold">
                  <%= resource._count.metricSnapshots %>
                </td>

                <!-- Actions -->
                <td class="px-6 py-4 text-right whitespace-nowrap">
                  <a href="/projects/<%= project.id %>/resources/<%= resource.id %>"
                     class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-semibold text-blue-400 bg-blue-950/40 border border-blue-800/40 hover:bg-blue-900/60 transition-colors">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
                    </svg>
                    Live Telemetry
                  </a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof flatpickr !== 'undefined') {
      const now = new Date();
      const past7 = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);

      flatpickr("#project-start-date", {
        enableTime: true,
        dateFormat: "Y-m-d H:i",
        defaultDate: past7,
        theme: "dark",
      });

      flatpickr("#project-end-date", {
        enableTime: true,
        dateFormat: "Y-m-d H:i",
        defaultDate: now,
        theme: "dark",
      });
    }
  });
</script>
