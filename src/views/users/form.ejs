<!-- User Create/Edit Form -->
<div class="max-w-2xl">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">
    <h2 class="text-lg font-semibold text-slate-100 mb-6"><%= editUser ? 'Edit User' : 'Create User' %></h2>

    <% if (errors) { %>
      <div class="mb-4 px-4 py-3 rounded-xl bg-red-900/30 border border-red-700/50 text-red-300 text-sm">
        Please fix the errors below.
      </div>
    <% } %>

    <form method="POST" action="<%= editUser ? '/users/' + editUser.id : '/users' %>">
      <div class="space-y-5">

        <div>
          <label for="name" class="block text-sm font-medium text-slate-300 mb-1.5">Full Name <span class="text-red-400">*</span></label>
          <input id="name" type="text" name="name" required
                 value="<%= editUser ? editUser.name : '' %>"
                 class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
        </div>

        <% if (!editUser) { %>
          <div>
            <label for="email" class="block text-sm font-medium text-slate-300 mb-1.5">Email <span class="text-red-400">*</span></label>
            <input id="email" type="email" name="email" required
                   class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
          </div>
          <div>
            <label for="password" class="block text-sm font-medium text-slate-300 mb-1.5">Password <span class="text-red-400">*</span></label>
            <input id="password" type="password" name="password" required minlength="12"
                   class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
            <p class="text-xs text-slate-500 mt-1">Min 12 chars with uppercase, lowercase, number, special char</p>
          </div>
        <% } %>

        <div>
          <label for="roleId" class="block text-sm font-medium text-slate-300 mb-1.5">Role <span class="text-red-400">*</span></label>
          <select id="roleId" name="roleId" required
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-100 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm">
            <% roles.forEach(function(role) { %>
              <option value="<%= role.id %>" <%= editUser && editUser.roleId === role.id ? 'selected' : '' %>>
                <%= role.name %> — <%= role.description %>
              </option>
            <% }); %>
          </select>
        </div>

        <% if (editUser) { %>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-1.5">Status</label>
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="active" value="true" <%= editUser.active ? 'checked' : '' %>
                     class="w-4 h-4 rounded border-slate-600 text-brand-600 bg-slate-700 focus:ring-brand-500">
              <span class="text-sm text-slate-300">Account is active</span>
            </label>
          </div>
        <% } %>
      </div>

      <div class="flex items-center gap-3 mt-8">
        <button type="submit"
                class="px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm transition-colors">
          <%= editUser ? 'Save Changes' : 'Create User' %>
        </button>
        <a href="/users" class="px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 hover:bg-slate-700 text-sm">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
