<!-- Users list -->
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-semibold text-slate-100">Users</h2>
      <p class="text-sm text-slate-400 mt-0.5"><%= total %> user<%= total !== 1 ? 's' : '' %></p>
    </div>
    <a href="/users/new" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-sm font-medium transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      New User
    </a>
  </div>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-slate-800">
          <th class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">User</th>
          <th class="text-left px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Role</th>
          <th class="text-center px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Status</th>
          <th class="text-right px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Last Login</th>
          <th class="text-right px-6 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% users.forEach(function(u) { %>
          <tr class="hover:bg-slate-800/40 transition-colors">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-gradient-to-br from-brand-500 to-purple-600 flex items-center justify-center text-xs font-semibold text-white">
                  <%= u.name.charAt(0).toUpperCase() %>
                </div>
                <div>
                  <div class="font-medium text-slate-200"><%= u.name %></div>
                  <div class="text-xs text-slate-500"><%= u.email %></div>
                </div>
              </div>
            </td>
            <td class="px-4 py-4">
              <span class="px-2 py-0.5 rounded text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
                <%= u.role.name %>
              </span>
            </td>
            <td class="px-4 py-4 text-center">
              <% if (u.active) { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Active
                </span>
              <% } else { %>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-slate-500/10 text-slate-400 border border-slate-500/20">
                  Inactive
                </span>
              <% } %>
            </td>
            <td class="px-4 py-4 text-right text-slate-400 text-xs">
              <%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleString() : 'Never' %>
            </td>
            <td class="px-6 py-4 text-right">
              <a href="/users/<%= u.id %>"
                 class="px-3 py-1.5 rounded-lg text-xs text-slate-300 border border-slate-700 hover:bg-slate-700 transition-colors">
                Edit
              </a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    <%- include('../partials/pagination.ejs', { page, totalPages, total }) %>
  </div>
</div>
