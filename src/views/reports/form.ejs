<!-- Report Form -->
<div class="max-w-3xl">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8"
       x-data="{
         selectedProject: '',
         resources: [],
         async loadResources(projectId) {
           if (!projectId) { this.resources = []; return; }
           // Resources are loaded inline for SSR simplicity
         }
       }">

    <h2 class="text-lg font-semibold text-slate-100 mb-6">Generate Report</h2>

    <form method="POST" action="/reports">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="space-y-6">

        <!-- Report Name -->
        <div>
          <label for="name" class="block text-sm font-medium text-slate-300 mb-1.5">Report Name <span class="text-red-400">*</span></label>
          <input id="name" type="text" name="name" required maxlength="200"
                 placeholder="e.g. Monthly Production Report — September 2025"
                 class="w-full px-4 py-2.5 rounded-xl bg-slate-800 border <%= errors && errors.name ? 'border-red-500' : 'border-slate-700' %>
                        text-slate-100 placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-brand-500 text-sm transition-all">
          <% if (errors && errors.name) { %><p class="mt-1 text-xs text-red-400"><%= errors.name[0] %></p><% } %>
        </div>

        <!-- Date Range with Flatpickr Calendar & Quick Presets -->
        <div>
          <div class="flex items-center justify-between mb-2">
            <label class="block text-sm font-medium text-slate-300">Reporting Time Period <span class="text-red-400">*</span></label>
            <div class="flex items-center gap-1.5" x-data>
              <button type="button" @click="
                const now = new Date();
                const past7 = new Date(Date.now() - 7*24*60*60*1000);
                document.getElementById('startDate')._flatpickr.setDate(past7);
                document.getElementById('endDate')._flatpickr.setDate(now);
              " class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs transition-colors">
                Last 7 Days
              </button>
              <button type="button" @click="
                const now = new Date();
                const past30 = new Date(Date.now() - 30*24*60*60*1000);
                document.getElementById('startDate')._flatpickr.setDate(past30);
                document.getElementById('endDate')._flatpickr.setDate(now);
              " class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs transition-colors">
                Last 30 Days
              </button>
              <button type="button" @click="
                const now = new Date();
                const firstDay = new Date(now.getFullYear(), now.getMonth(), 1);
                document.getElementById('startDate')._flatpickr.setDate(firstDay);
                document.getElementById('endDate')._flatpickr.setDate(now);
              " class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-300 text-xs transition-colors">
                This Month
              </button>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="startDate" class="block text-xs text-slate-400 mb-1">Start Date & Time</label>
              <div class="relative">
                <input id="startDate" type="text" name="startDate" required placeholder="Select start date..."
                       class="w-full px-4 py-2.5 pl-10 rounded-xl bg-slate-800 border border-slate-700 text-slate-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm transition-all flatpickr-input">
                <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
            <div>
              <label for="endDate" class="block text-xs text-slate-400 mb-1">End Date & Time</label>
              <div class="relative">
                <input id="endDate" type="text" name="endDate" required placeholder="Select end date..."
                       class="w-full px-4 py-2.5 pl-10 rounded-xl bg-slate-800 border border-slate-700 text-slate-100
                              focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm transition-all flatpickr-input">
                <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
              </div>
            </div>
          </div>
        </div>

        <script>
          document.addEventListener('DOMContentLoaded', function() {
            if (typeof flatpickr !== 'undefined') {
              const defaultEnd = new Date();
              const defaultStart = new Date(Date.now() - 7 * 24 * 60 * 60 * 1000);

              flatpickr("#startDate", {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                defaultDate: defaultStart,
                theme: "dark",
                animate: true,
              });

              flatpickr("#endDate", {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                defaultDate: defaultEnd,
                theme: "dark",
                animate: true,
              });
            }
          });
        </script>

        <!-- Resources (checkboxes by project) -->
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-3">Resources <span class="text-red-400">*</span></label>
          <div class="space-y-4">
            <% projects.forEach(function(project) { %>
              <% if (project.resources && project.resources.length > 0) { %>
              <div class="bg-slate-800 border border-slate-700 rounded-xl p-4">
                <div class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-3">
                  <%= project.name %>
                </div>
                <div class="space-y-2">
                  <% project.resources.forEach(function(res) { %>
                    <label class="flex items-center gap-3 cursor-pointer">
                      <input type="checkbox" name="resourceIds" value="<%= res.id %>"
                             class="w-4 h-4 rounded border-slate-600 text-brand-600 bg-slate-700 focus:ring-brand-500">
                      <span class="text-sm text-slate-300"><%= res.name %></span>
                      <span class="text-xs text-slate-500 font-mono"><%= res.awsResourceId %></span>
                      <span class="text-xs text-slate-600"><%= res.region %></span>
                    </label>
                  <% }); %>
                </div>
              </div>
              <% } %>
            <% }); %>
          </div>
          <% if (errors && errors.resourceIds) { %><p class="mt-1 text-xs text-red-400"><%= errors.resourceIds[0] %></p><% } %>
        </div>

        <!-- Metrics to include -->
        <div>
          <label class="block text-sm font-medium text-slate-300 mb-3">Include Metrics <span class="text-red-400">*</span></label>
          <div class="grid grid-cols-2 gap-2">
            <% [['cpu', 'CPU Utilization (%)'], ['concurrentUsers', 'Concurrent Users (Active Sessions)'], ['memory', 'Memory Utilization (%)'], ['disk', 'Disk Utilization (%)'], ['network', 'Network In/Out']].forEach(function(m) { %>
              <label class="flex items-center gap-3 bg-slate-800 border border-slate-700 rounded-xl p-3 cursor-pointer hover:border-slate-600 transition-colors">
                <input type="checkbox" name="includeMetrics" value="<%= m[0] %>" checked
                       class="w-4 h-4 rounded border-slate-600 text-brand-600 bg-slate-700 focus:ring-brand-500">
                <span class="text-sm text-slate-300"><%= m[1] %></span>
              </label>
            <% }); %>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-3 mt-8">
        <button type="submit"
                class="px-6 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-500 text-white font-semibold text-sm transition-colors shadow-lg shadow-violet-900/30">
          Generate Report
        </button>
        <a href="/reports" class="px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 hover:bg-slate-700 text-sm transition-colors">
          Cancel
        </a>
      </div>
    </form>
  </div>
</div>
