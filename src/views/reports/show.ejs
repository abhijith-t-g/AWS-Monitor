<!-- Report Status Page -->
<div class="max-w-2xl">
  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8">

    <div class="flex items-start justify-between mb-6">
      <div>
        <h2 class="text-lg font-semibold text-slate-100"><%= report.name %></h2>
        <p class="text-xs text-slate-500 mt-1">Requested <%= new Date(report.createdAt).toLocaleString() %></p>
      </div>

      <!-- Status Badge — HTMX polls this while PENDING/PROCESSING -->
      <div id="report-status"
           <% if (report.status === 'PENDING' || report.status === 'PROCESSING') { %>
             hx-get="/reports/<%= report.id %>/status"
             hx-trigger="every 3s"
             hx-target="#report-status"
             hx-swap="outerHTML"
           <% } %>>
        <%- include('./partials/status-badge.ejs', { report }) %>
      </div>
    </div>

    <% if (report.status === 'COMPLETED') { %>
      <div class="flex items-center gap-3 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 mb-6">
        <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        <div>
          <p class="text-sm font-medium text-emerald-300">Report ready for download</p>
          <p class="text-xs text-emerald-500 mt-0.5">Completed <%= new Date(report.completedAt).toLocaleString() %></p>
        </div>
      </div>

      <a href="/reports/<%= report.id %>/download"
         class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm transition-colors shadow-lg shadow-emerald-900/30">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Download Excel
      </a>

    <% } else if (report.status === 'FAILED') { %>
      <div class="p-4 rounded-xl bg-red-500/10 border border-red-500/20">
        <p class="text-sm font-medium text-red-300">Report generation failed</p>
        <% if (report.errorMessage) { %>
          <p class="text-xs text-red-400 mt-1"><%= report.errorMessage %></p>
        <% } %>
      </div>
    <% } else { %>
      <div class="flex items-center gap-3 p-4 rounded-xl bg-brand-500/10 border border-brand-500/20">
        <svg class="w-5 h-5 text-brand-400 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
        <p class="text-sm text-brand-300">Generating report… This page will update automatically.</p>
      </div>
    <% } %>

    <div class="mt-8 border-t border-slate-800 pt-6">
      <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wide mb-3">Report Parameters</h3>
      <% const params = report.parameters; %>
      <dl class="space-y-2 text-sm">
        <div class="flex gap-4">
          <dt class="text-slate-500 w-28">Period</dt>
          <dd class="text-slate-300"><%= new Date(params.startDate).toLocaleDateString() %> — <%= new Date(params.endDate).toLocaleDateString() %></dd>
        </div>
        <div class="flex gap-4">
          <dt class="text-slate-500 w-28">Resources</dt>
          <dd class="text-slate-300"><%= params.resourceIds.length %> selected</dd>
        </div>
        <div class="flex gap-4">
          <dt class="text-slate-500 w-28">Metrics</dt>
          <dd class="text-slate-300"><%= params.includeMetrics.join(', ') %></dd>
        </div>
      </dl>
    </div>

    <div class="mt-6">
      <a href="/reports" class="text-sm text-slate-400 hover:text-slate-200 transition-colors">← All Reports</a>
    </div>
  </div>
</div>
