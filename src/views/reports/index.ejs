<!-- Reports List -->
<div class="space-y-6">
  <div class="flex items-center justify-between">
    <div>
      <h2 class="text-lg font-semibold text-slate-100">Reports</h2>
      <p class="text-sm text-slate-400 mt-0.5"><%= total %> report<%= total !== 1 ? 's' : '' %></p>
    </div>
    <a href="/reports/new"
       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-violet-600 hover:bg-violet-500 text-white text-sm font-medium transition-colors shadow-lg shadow-violet-900/30">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Generate Report
    </a>
  </div>

  <% if (reports.length === 0) { %>
    <div class="bg-slate-900 border border-slate-800 rounded-2xl flex flex-col items-center justify-center py-16 text-center">
      <svg class="w-12 h-12 text-slate-700 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
              d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
      </svg>
      <p class="text-slate-500 text-sm">No reports yet</p>
      <a href="/reports/new" class="mt-3 text-violet-400 hover:text-violet-300 text-sm">Generate your first report →</a>
    </div>
  <% } else { %>
    <div class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-800">
            <th class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Report Name</th>
            <th class="text-center px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Status</th>
            <th class="text-right px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Requested</th>
            <th class="text-right px-6 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800">
          <% reports.forEach(function(report) { %>
            <tr class="hover:bg-slate-800/40 transition-colors">
              <td class="px-6 py-4">
                <a href="/reports/<%= report.id %>" class="font-medium text-slate-100 hover:text-violet-400 transition-colors">
                  <%= report.name %>
                </a>
              </td>
              <td class="px-4 py-4 text-center">
                <%- include('./partials/status-badge.ejs', { report }) %>
              </td>
              <td class="px-4 py-4 text-right text-slate-400 text-xs">
                <%= new Date(report.createdAt).toLocaleString() %>
              </td>
              <td class="px-6 py-4 text-right">
                <% if (report.status === 'COMPLETED') { %>
                  <a href="/reports/<%= report.id %>/download"
                     class="px-3 py-1.5 rounded-lg text-xs text-emerald-400 border border-emerald-600/30 hover:bg-emerald-600/10 transition-colors">
                    Download
                  </a>
                <% } else { %>
                  <a href="/reports/<%= report.id %>"
                     class="px-3 py-1.5 rounded-lg text-xs text-slate-400 border border-slate-700 hover:bg-slate-700 transition-colors">
                    View
                  </a>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <%- include('../partials/pagination.ejs', { page, totalPages, total }) %>
    </div>
  <% } %>
</div>
