<!-- Dashboard Page -->
<div class="space-y-6">

  <!-- Stats Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">

    <!-- Total Projects -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition-colors">
      <div class="flex items-center justify-between mb-3">
        <div class="w-10 h-10 rounded-xl bg-brand-500/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <span class="text-xs text-slate-500 font-medium uppercase tracking-wide">Projects</span>
      </div>
      <div class="text-3xl font-bold text-white"><%= stats.totalProjects %></div>
      <div class="text-xs text-slate-500 mt-1">Active projects</div>
    </div>

    <!-- Total Resources -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition-colors">
      <div class="flex items-center justify-between mb-3">
        <div class="w-10 h-10 rounded-xl bg-violet-500/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" />
          </svg>
        </div>
        <span class="text-xs text-slate-500 font-medium uppercase tracking-wide">Resources</span>
      </div>
      <div class="text-3xl font-bold text-white"><%= stats.totalResources %></div>
      <div class="text-xs text-slate-500 mt-1">Monitored resources</div>
    </div>

    <!-- Healthy -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition-colors">
      <div class="flex items-center justify-between mb-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <span class="text-xs text-emerald-500 font-medium uppercase tracking-wide">Healthy</span>
      </div>
      <div class="text-3xl font-bold text-emerald-400"><%= stats.healthyResourceCount %></div>
      <div class="text-xs text-slate-500 mt-1">No issues detected</div>
    </div>

    <!-- Issues -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition-colors">
      <div class="flex items-center justify-between mb-3">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 flex items-center justify-center">
          <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <span class="text-xs text-amber-500 font-medium uppercase tracking-wide">Issues</span>
      </div>
      <div class="text-3xl font-bold text-amber-400"><%= stats.resourcesWithIssues %></div>
      <div class="text-xs text-slate-500 mt-1">Collection issues (15m)</div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

    <!-- Recent Activity (spans 2 cols) -->
    <div class="lg:col-span-2 bg-slate-900 border border-slate-800 rounded-2xl">
      <div class="px-6 py-4 border-b border-slate-800 flex items-center justify-between">
        <h2 class="text-sm font-semibold text-slate-200">Recent Metric Snapshots</h2>
        <span class="text-xs text-slate-500">Last 24 hours</span>
      </div>

      <% if (recentSnapshots.length === 0) { %>
        <div class="flex flex-col items-center justify-center py-16 text-center">
          <svg class="w-12 h-12 text-slate-700 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          <p class="text-slate-500 text-sm">No metrics collected yet</p>
          <p class="text-slate-600 text-xs mt-1">Add projects and resources to begin monitoring</p>
        </div>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-slate-800">
                <th class="text-left px-6 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Resource</th>
                <th class="text-left px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Project</th>
                <th class="text-right px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">CPU</th>
                <th class="text-right px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Memory</th>
                <th class="text-right px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Timestamp</th>
                <th class="text-center px-4 py-3 text-xs font-medium text-slate-400 uppercase tracking-wide">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800">
              <% recentSnapshots.forEach(function(snap) { %>
                <tr class="hover:bg-slate-800/40 transition-colors">
                  <td class="px-6 py-3">
                    <div class="font-medium text-slate-200"><%= snap.resource.name %></div>
                    <div class="text-xs text-slate-500 font-mono"><%= snap.resource.awsResourceId %></div>
                  </td>
                  <td class="px-4 py-3 text-slate-400"><%= snap.resource.project.name %></td>
                  <td class="px-4 py-3 text-right">
                    <% if (snap.cpuUtilization != null) { %>
                      <span class="font-mono text-slate-300"><%= snap.cpuUtilization.toFixed(1) %>%</span>
                    <% } else { %>
                      <span class="text-slate-600">—</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <% if (snap.memoryUtilization != null) { %>
                      <span class="font-mono text-slate-300"><%= snap.memoryUtilization.toFixed(1) %>%</span>
                    <% } else { %>
                      <span class="text-slate-600">—</span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-right text-slate-400 text-xs">
                    <%= snap.timestamp.toLocaleString() %>
                  </td>
                  <td class="px-4 py-3 text-center">
                    <% if (snap.collectionStatus === 'SUCCESS') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">OK</span>
                    <% } else if (snap.collectionStatus === 'PARTIAL') { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-500/10 text-amber-400 border border-amber-500/20">Partial</span>
                    <% } else { %>
                      <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-red-500/10 text-red-400 border border-red-500/20">Failed</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- System Status Panel -->
    <div class="space-y-4">

      <!-- Queue Status -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
        <div class="flex items-center justify-between mb-4">
          <h3 class="text-sm font-semibold text-slate-200">Queue Status</h3>
          <div class="w-2 h-2 rounded-full <%= queueStats ? 'bg-emerald-400 animate-pulse' : 'bg-red-400' %>"></div>
        </div>

        <% if (queueStats) { %>
          <div class="space-y-3">
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-400">Waiting</span>
              <span class="font-mono text-sm text-slate-300"><%= queueStats.waiting %></span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-400">Active</span>
              <span class="font-mono text-sm text-emerald-400"><%= queueStats.active %></span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-xs text-slate-400">Failed</span>
              <span class="font-mono text-sm <%= queueStats.failed > 0 ? 'text-red-400' : 'text-slate-300' %>"><%= queueStats.failed %></span>
            </div>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-500">Queue unavailable</p>
        <% } %>

        <!-- Collect Now button (HTMX) -->
        <button
          hx-post="/dashboard/collect-now"
          hx-target="#collection-status"
          hx-swap="innerHTML"
          hx-indicator=".htmx-indicator"
          class="mt-4 w-full px-3 py-2 rounded-lg bg-brand-600/20 border border-brand-600/30 text-brand-400
                 hover:bg-brand-600/30 text-xs font-medium transition-colors">
          ⚡ Collect Now
        </button>
        <div id="collection-status" class="mt-2 text-xs text-slate-500"></div>
      </div>

      <!-- Quick Links -->
      <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5">
        <h3 class="text-sm font-semibold text-slate-200 mb-4">Quick Actions</h3>
        <div class="space-y-2">
          <a href="/projects/new"
             class="flex items-center gap-2 px-3 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white text-sm transition-colors">
            <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Project
          </a>
          <a href="/reports/new"
             class="flex items-center gap-2 px-3 py-2.5 rounded-lg bg-slate-800 hover:bg-slate-750 text-slate-300 hover:text-white text-sm transition-colors">
            <svg class="w-4 h-4 text-violet-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            Generate Report
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
