<!-- Flash messages are embedded via URL query params or server-set locals -->
<% if (typeof flashError !== 'undefined' && flashError) { %>
<div class="mb-6 flex items-center gap-3 px-4 py-3 rounded-xl bg-red-900/30 border border-red-700/50 text-red-300"
     x-data="{ show: true }" x-show="show" x-transition>
  <svg class="w-5 h-5 text-red-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
  </svg>
  <span class="text-sm"><%= flashError %></span>
  <button @click="show = false" class="ml-auto text-red-400 hover:text-red-200">✕</button>
</div>
<% } %>

<% if (typeof flashSuccess !== 'undefined' && flashSuccess) { %>
<div class="mb-6 flex items-center gap-3 px-4 py-3 rounded-xl bg-emerald-900/30 border border-emerald-700/50 text-emerald-300"
     x-data="{ show: true }" x-show="show" x-transition>
  <svg class="w-5 h-5 text-emerald-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
  </svg>
  <span class="text-sm"><%= flashSuccess %></span>
  <button @click="show = false" class="ml-auto text-emerald-400 hover:text-emerald-200">✕</button>
</div>
<% } %>
