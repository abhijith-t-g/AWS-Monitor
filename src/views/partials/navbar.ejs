<header class="flex-shrink-0 bg-slate-900/80 backdrop-blur-sm border-b border-slate-800 px-6 lg:px-8 py-4">
  <div class="flex items-center justify-between">
    <h1 class="text-lg font-semibold text-slate-100">
      <%= typeof title !== 'undefined' ? title : '' %>
    </h1>
    <div class="flex items-center gap-3">
      <!-- HTMX loading indicator -->
      <div class="htmx-indicator">
        <div class="flex items-center gap-2 text-sm text-brand-400">
          <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
          </svg>
          Loading...
        </div>
      </div>
      <div class="h-4 w-px bg-slate-700"></div>
      <span class="text-xs text-slate-500">
        <%= new Date().toLocaleString('en-US', { timeZone: 'UTC', dateStyle: 'medium', timeStyle: 'short' }) %> UTC
      </span>
    </div>
  </div>
</header>
