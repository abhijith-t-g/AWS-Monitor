<!-- Metric Charts & Data Table Partial (HTMX response) -->
<% const data = JSON.parse(chartData); %>
<% const snaps = typeof snapshots !== 'undefined' ? snapshots : []; %>

<!-- Chart Payload JSON for script consumption -->
<script id="chart-payload" type="application/json"><%- chartData %></script>

<script>
(function() {
  const payloadEl = document.getElementById('chart-payload');
  const CHART_DATA = payloadEl ? JSON.parse(payloadEl.textContent || '{}') : { labels: [], cpu: [], memory: [], disk: [], networkIn: [] };
  const LABELS = (CHART_DATA.labels || []).map(function(l) {
    const d = new Date(l);
    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
  });

  const chartDefaults = {
    type: 'line',
    options: {
      responsive: true,
      maintainAspectRatio: false,
      animation: { duration: 400 },
      plugins: {
        legend: { display: false },
        tooltip: {
          backgroundColor: '#0f172a',
          borderColor: '#334155',
          borderWidth: 1,
          titleColor: '#94a3b8',
          bodyColor: '#e2e8f0',
          padding: 10,
          cornerRadius: 8,
        }
      },
      scales: {
        x: {
          ticks: { color: '#64748b', maxTicksLimit: 8, font: { size: 11 } },
          grid: { color: '#1e293b' }
        },
        y: {
          ticks: { color: '#64748b', font: { size: 11 } },
          grid: { color: '#1e293b' }
        }
      },
      elements: {
        point: { radius: 2, hoverRadius: 5 },
        line: { borderWidth: 2, tension: 0.3 }
      }
    }
  };

  function createChart(canvasId, label, chartValues, color, unit) {
    const ctx = document.getElementById(canvasId);
    if (!ctx) return;
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: LABELS,
        datasets: [{
          label: label,
          data: chartValues || [],
          borderColor: color,
          backgroundColor: color + '15',
          fill: true,
        }]
      },
      options: {
        ...chartDefaults.options,
        scales: {
          ...chartDefaults.options.scales,
          y: {
            ...chartDefaults.options.scales.y,
            ticks: {
              ...chartDefaults.options.scales.y.ticks,
              callback: function(v) { return v + unit; }
            }
          }
        }
      }
    });
  }

  // Wait for Chart.js to be loaded
  if (typeof Chart !== 'undefined') {
    createChart('cpu-chart', 'CPU Utilization', CHART_DATA.cpu, '#3b82f6', '%');
    createChart('memory-chart', 'Memory Utilization', CHART_DATA.memory, '#8b5cf6', '%');
    createChart('disk-chart', 'Disk Utilization', CHART_DATA.disk, '#f59e0b', '%');
    createChart('network-chart', 'Network In', CHART_DATA.networkIn, '#10b981', ' MB');
  }
})();
</script>

<div class="space-y-4" x-data="{ viewMode: 'charts', search: '' }">
  <!-- View Toggle Header -->
  <div class="flex items-center justify-between pb-2 border-b border-slate-800">
    <div class="flex items-center gap-1 bg-slate-900 border border-slate-800 p-1 rounded-xl">
      <button
        type="button"
        @click="viewMode = 'charts'"
        :class="viewMode === 'charts' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200'"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z" />
        </svg>
        Visual Charts
      </button>

      <button
        type="button"
        @click="viewMode = 'table'"
        :class="viewMode === 'table' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-400 hover:text-slate-200'"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-semibold transition-all">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Data Table (<%= snaps.length %> records)
      </button>
    </div>

    <!-- Quick Stats Summary -->
    <% 
      const validCpus = data.cpu.filter(function(c) { return c !== null; });
      const avgCpu = validCpus.length ? (validCpus.reduce(function(a,b) { return a+b; }, 0) / validCpus.length).toFixed(1) : '—';
      const maxCpu = validCpus.length ? Math.max.apply(null, validCpus).toFixed(1) : '—';
    %>
    <div class="hidden sm:flex items-center gap-4 text-xs">
      <div class="flex items-center gap-1.5 text-slate-400">
        <span class="w-2 h-2 rounded-full bg-blue-500"></span>
        Avg CPU: <span class="font-semibold text-slate-200"><%= avgCpu %>%</span>
      </div>
      <div class="flex items-center gap-1.5 text-slate-400">
        <span class="w-2 h-2 rounded-full bg-amber-500"></span>
        Peak CPU: <span class="font-semibold text-slate-200"><%= maxCpu %>%</span>
      </div>
    </div>
  </div>

  <!-- VIEW 1: Charts Grid -->
  <div x-show="viewMode === 'charts'" class="grid grid-cols-1 lg:grid-cols-2 gap-4">
    <!-- CPU -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-blue-500"></div>
          <h4 class="text-sm font-semibold text-slate-200">CPU Utilization</h4>
        </div>
        <span class="text-xs text-slate-500 font-medium">% over <%= hours %>h</span>
      </div>
      <div class="h-48">
        <canvas id="cpu-chart"></canvas>
      </div>
    </div>

    <!-- Memory -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-purple-500"></div>
          <h4 class="text-sm font-semibold text-slate-200">Memory Utilization</h4>
        </div>
        <span class="text-xs text-slate-500 font-medium">CloudWatch Agent</span>
      </div>
      <div class="h-48">
        <canvas id="memory-chart"></canvas>
      </div>
    </div>

    <!-- Disk -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-amber-500"></div>
          <h4 class="text-sm font-semibold text-slate-200">Disk Utilization</h4>
        </div>
        <span class="text-xs text-slate-500 font-medium">Disk usage %</span>
      </div>
      <div class="h-48">
        <canvas id="disk-chart"></canvas>
      </div>
    </div>

    <!-- Network -->
    <div class="bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <div class="flex items-center gap-2">
          <div class="w-2.5 h-2.5 rounded-full bg-emerald-500"></div>
          <h4 class="text-sm font-semibold text-slate-200">Network Telemetry</h4>
        </div>
        <span class="text-xs text-slate-500 font-medium">MB transferred</span>
      </div>
      <div class="h-48">
        <canvas id="network-chart"></canvas>
      </div>
    </div>
  </div>

  <!-- VIEW 2: Data Table -->
  <div x-show="viewMode === 'table'" x-cloak class="bg-slate-900 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    <div class="p-4 border-b border-slate-800 flex items-center justify-between gap-4">
      <div>
        <h4 class="text-sm font-semibold text-slate-200">Telemetry Snapshots</h4>
        <p class="text-xs text-slate-500">Raw time-series data captured from AWS CloudWatch</p>
      </div>
      <div class="flex items-center gap-2">
        <input
          type="text"
          x-model="search"
          placeholder="Filter timestamp / values..."
          class="px-3 py-1.5 rounded-xl bg-slate-800 border border-slate-700 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-blue-500 w-48">
      </div>
    </div>

    <div class="overflow-x-auto max-h-96 overflow-y-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-950/80 sticky top-0 text-slate-400 font-semibold border-b border-slate-800">
          <tr>
            <th class="px-4 py-3">Timestamp (Local)</th>
            <th class="px-4 py-3">CPU Usage</th>
            <th class="px-4 py-3">Memory Usage</th>
            <th class="px-4 py-3">Disk Usage</th>
            <th class="px-4 py-3">Network In</th>
            <th class="px-4 py-3">Network Out</th>
            <th class="px-4 py-3">DB Conn</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800 text-slate-300 font-mono">
          <% if (snaps.length === 0) { %>
            <tr>
              <td colspan="7" class="px-4 py-8 text-center text-slate-500 font-sans">
                No telemetry snapshots recorded in this timeframe. Make sure the background worker is running.
              </td>
            </tr>
          <% } else { %>
            <% snaps.forEach(function(s) { %>
              <%
                const cpuVal = s.cpuUtilization !== null ? s.cpuUtilization.toFixed(1) : null;
                const memVal = s.memoryUtilization !== null ? s.memoryUtilization.toFixed(1) : null;
                const diskVal = s.diskUtilization !== null ? s.diskUtilization.toFixed(1) : null;
                const netInMb = s.networkInBytes !== null ? (Number(s.networkInBytes) / (1024*1024)).toFixed(2) : null;
                const netOutMb = s.networkOutBytes !== null ? (Number(s.networkOutBytes) / (1024*1024)).toFixed(2) : null;
                const isHigh = cpuVal !== null && Number(cpuVal) >= 80;
                const isWarn = cpuVal !== null && Number(cpuVal) >= 60 && Number(cpuVal) < 80;
                const widthPercent = cpuVal !== null ? Math.min(Number(cpuVal), 100) : 0;
              %>
              <tr class="hover:bg-slate-800/50 transition-colors">
                <td class="px-4 py-2.5 text-slate-400 font-sans whitespace-nowrap">
                  <%= new Date(s.timestamp).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit' }) %>
                </td>
                <td class="px-4 py-2.5 whitespace-nowrap">
                  <% if (cpuVal !== null) { %>
                    <div class="flex items-center gap-2">
                      <span class="px-1.5 py-0.5 rounded text-[11px] font-bold <%= isHigh ? 'bg-red-900/40 text-red-400 border border-red-700/50' : (isWarn ? 'bg-amber-900/40 text-amber-400 border border-amber-700/50' : 'bg-emerald-900/30 text-emerald-400') %>">
                        <%= cpuVal %>%
                      </span>
                      <div class="w-12 h-1.5 rounded-full bg-slate-800 overflow-hidden">
                        <div class="h-full <%= isHigh ? 'bg-red-500' : (isWarn ? 'bg-amber-500' : 'bg-blue-500') %>" :style="'width: <%= widthPercent %>%'"></div>
                      </div>
                    </div>
                  <% } else { %>
                    <span class="text-slate-600">—</span>
                  <% } %>
                </td>
                <td class="px-4 py-2.5 whitespace-nowrap">
                  <%= memVal !== null ? memVal + '%' : '<span class="text-slate-600">—</span>' %>
                </td>
                <td class="px-4 py-2.5 whitespace-nowrap">
                  <%= diskVal !== null ? diskVal + '%' : '<span class="text-slate-600">—</span>' %>
                </td>
                <td class="px-4 py-2.5 whitespace-nowrap">
                  <%= netInMb !== null ? netInMb + ' MB' : '<span class="text-slate-600">—</span>' %>
                </td>
                <td class="px-4 py-2.5 whitespace-nowrap">
                  <%= netOutMb !== null ? netOutMb + ' MB' : '<span class="text-slate-600">—</span>' %>
                </td>
                <td class="px-4 py-2.5 whitespace-nowrap">
                  <%= s.databaseConnections !== null ? s.databaseConnections : '<span class="text-slate-600">—</span>' %>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
